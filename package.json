{
  "name": "angel-devil-mcp",
  "version": "0.1.0",
  "description": "Angel & Devil MCP — a deterministic, zero-LLM-call MCP server that stages theatrical Angel-vs-Devil inner-conflict debates for a Client LLM to perform.",
  "type": "module",
  "bin": {
    "angel-devil-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "angel",
    "devil",
    "debate",
    "sqlite",
    "stdio"
  ],
  "author": "jxz6 <rokunoy@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxz6/angel-devil-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jxz6/angel-devil-mcp/issues"
  },
  "homepage": "https://github.com/jxz6/angel-devil-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "better-sqlite3": "^11.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  }
}
