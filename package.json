{
  "name": "brain-fight-mcp",
  "version": "0.1.0",
  "description": "Brain Fight MCP — a deterministic, zero-LLM-call MCP server that stages theatrical Angel-vs-Devil inner-conflict debates for a Client LLM to perform.",
  "type": "module",
  "bin": {
    "brain-fight-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http --port 8000",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http --port 8000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "brain-fight",
    "angel",
    "devil",
    "debate",
    "sqlite",
    "stdio",
    "streamable-http",
    "http"
  ],
  "author": "rkny6 <rokunoy@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkny6/brain-fight-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rkny6/brain-fight-mcp/issues"
  },
  "homepage": "https://github.com/rkny6/brain-fight-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "better-sqlite3": "^11.9.1",
    "express": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/body-parser": "^1.19.6",
    "@types/connect": "^3.4.38",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.2",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^22.13.10",
    "@types/qs": "^6.15.1",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/serve-static": "^2.2.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  }
}
