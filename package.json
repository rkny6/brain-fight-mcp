  "description": "Angel & Devil MCP — a deterministic, zero-LLM-call MCP server that stages theatrical Angel-vs-Devil inner-conflict debates for a Client LLM to perform.",
  "type": "module",
  "bin": {
    "angel-devil-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
